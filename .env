
import requests


BASE_URL = "https://yassparfums.com"
ENDPOINT = "/api/products"


def test_get_products_diagnostic():
    url = f"{BASE_URL}{ENDPOINT}"

    response = requests.get(
        url,
        params={"page": 1, "limit": 5},
        timeout=20
    )

    print(f"\nURL appelée : {response.url}")
    print(f"Status HTTP : {response.status_code}")
    print(f"Content-Type : {response.headers.get('Content-Type')}")
    print(f"Réponse :\n{response.text[:5000]}")

    assert response.status_code == 200, (
        f"GET products a retourné HTTP {response.status_code}. "
        f"Réponse : {response.text[:1000]}"
    )

    assert "application/json" in response.headers.get(
        "Content-Type", ""
    ).lower(), "La réponse ne semble pas être du JSON"
